{
  "name": "roua-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ROUA: Read-Only User Account standard and toolkit",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/core",
    "packages/app",
    "packages/cli",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/app packages/cli && node scripts/generate-audit-sql.mjs && npm run build -w apps/web",
    "typecheck": "tsc -b packages/core packages/app packages/cli apps/web",
    "test": "vitest run",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
