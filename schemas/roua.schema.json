{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PromiseGithub/roua/schemas/roua.schema.json",
  "title": "ROUA account definition (roua.yaml), spec 0.1",
  "description": "Defines one Read-Only User Account. Never contains a password. The roua tool enforces further rules (expiry within the profile maximum, two approvers and at most 24 hours for L5) that JSON Schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["roua_version", "account", "target"],
  "properties": {
    "roua_version": { "const": "0.1" },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "profile", "level", "owner", "purpose", "expires_at"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,62}$", "description": "Convention: roua_<profile>_<label>" },
        "profile": { "enum": ["agent", "demo", "review", "audit", "support", "training", "analytics", "custom"] },
        "level": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
        "owner": { "type": "string", "pattern": "^[^\s\"'\\]+$", "description": "The accountable human" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 200 },
        "approved_by": {
          "oneOf": [
            { "type": "string", "pattern": "^[^\s\"'\\]+$" },
            { "type": "array", "items": { "type": "string", "pattern": "^[^\s\"'\\]+$" } }
          ]
        },
        "approval_ref": { "type": "string", "pattern": "^[^\s\"'\\]+$" },
        "expires_at": { "type": "string", "format": "date-time" },
        "level_role": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,62}$" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_connections": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "statement_timeout_s": { "type": "integer", "minimum": 1, "maximum": 86400 }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_sources": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+(/\d{1,3})?$" } }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "database", "schemas"],
      "properties": {
        "engine": { "const": "postgresql" },
        "database": { "$ref": "#/$defs/identifier" },
        "schemas": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } },
        "object_owner": { "$ref": "#/$defs/identifier" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": { "$ref": "#/$defs/patterns" },
        "exclude": { "$ref": "#/$defs/patterns" },
        "public_objects": { "$ref": "#/$defs/patterns" },
        "analytics_views": { "$ref": "#/$defs/patterns" },
        "columns_deny": { "$ref": "#/$defs/columns" },
        "columns_allow": { "$ref": "#/$defs/columns" },
        "column_grants": { "enum": ["always", "when_needed"], "description": "always (default): grant per column, so columns added later stay hidden until setup runs again. when_needed: whole-table grants when no column is hidden." },
        "mask": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/columnRef" },
          "additionalProperties": { "enum": ["email", "partial_last4", "redact", "hash", "year_only", "initials"] }
        }
      }
    },
    "hardening": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revoke_temp_from_public": { "type": "boolean" },
        "revoke_public_schema_create": { "type": "boolean" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["scram_verifier", "password"] },
        "password_env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]{0,62}$" },
    "columnRef": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]{0,62}\.[A-Za-z_][A-Za-z0-9_$]{0,62}\.[A-Za-z_][A-Za-z0-9_$]{0,62}$" },
    "patterns": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9_$*]+\.[A-Za-z0-9_$*]+$" } },
    "columns": { "type": "array", "items": { "$ref": "#/$defs/columnRef" } }
  }
}
